# Three consecutive Railway deploys failed with a network-flavored error
# right after this repo's first npm dependency (esbuild, see build.js)
# landed -- GitHub Actions' own "Asset build" CI job runs the identical
# `npm ci && npm run build` on every one of those same commits and passed
# every time, so the code isn't the problem; Railway's build sandbox is
# just a less forgiving network than GH Actions' runners. This raises npm's
# own retry tolerance for registry fetches so a transient blip there
# doesn't take the whole install down.
fetch-retries=5
fetch-retry-mintimeout=2000
fetch-retry-maxtimeout=30000
